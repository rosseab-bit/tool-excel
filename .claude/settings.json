{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "lider-tecnico",
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(scripts/dev.sh:*)",
      "Bash(scripts/build_linux.sh:*)",
      "Bash(xvfb-run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Bash(git push:*)"
    ]
  }
}